# ==============================================================================
# Nexus AIOS Environment Configuration Template
# Copy this file to '.env' and provide your actual API keys and preferences.
# NEVER commit your '.env' file containing secrets to git!
# ==============================================================================

# Cloud LLM Provider API Key (Required for cloud inference)
NEXUS_API_KEY=your_api_key_here

# Cloud Provider Settings
# Options: 'openai' | 'anthropic' | 'groq' | 'openrouter'
NEXUS_CLOUD_PROVIDER=openai
NEXUS_CLOUD_MODEL=gpt-4o-mini
NEXUS_CLOUD_URL=https://api.openai.com/v1

# Preferred Inference Router
# Options: 'local' (offline first) | 'cloud' (cloud first)
NEXUS_ROUTER_PREFER=local
NEXUS_ROUTER_TIMEOUT=15

# Local Model Settings (Ollama or llama.cpp)
NEXUS_LOCAL_TYPE=ollama
NEXUS_LOCAL_URL=http://127.0.0.1:11434
NEXUS_LOCAL_MODEL=llama3.2:1b

# Daemon API Host & Port
NEXUS_API_HOST=127.0.0.1
NEXUS_API_PORT=8765
